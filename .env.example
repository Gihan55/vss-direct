# VSS Supabase configuration.
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# When both are set, VSS uses the shared Postgres database + real auth.
# When either is empty, VSS falls back to the local `localStorage` demo.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
